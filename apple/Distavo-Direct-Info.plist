<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Direct-edition supplemental Info.plist (merged into the generated plist:
       GENERATE_INFOPLIST_FILE=YES + INFOPLIST_FILE on the Distavo target). Same
       as Distavo-Extra-Info.plist PLUS the Sparkle auto-update keys, which must
       live in a real plist (there is no INFOPLIST_KEY_* build setting for them).
       Only the Direct target uses this file, so Sparkle keys never reach the
       App Store / Setapp builds. -->
  <key>NSAudioCaptureUsageDescription</key>
  <string>Distavo records the meeting audio playing on this Mac (the other participants) when you choose Record meeting. The audio never leaves your Mac except to the transcription/summary engines you configured.</string>
  <!-- Calendar-aware titling (Vikunja #2946): read-only; only asked when the user
       presses "Allow calendar access…" in Settings. -->
  <key>NSCalendarsFullAccessUsageDescription</key>
  <string>Distavo reads the title and attendees of the calendar event that overlaps a recording to name the note. It never changes your calendar and nothing leaves your Mac.</string>
  <key>NSCalendarsUsageDescription</key>
  <string>Distavo reads the title and attendees of the calendar event that overlaps a recording to name the note. It never changes your calendar and nothing leaves your Mac.</string>
  <!-- Reminders export (Vikunja #2941): only asked the first time the user
       chooses "Send to Reminders". -->
  <key>NSRemindersFullAccessUsageDescription</key>
  <string>Distavo adds the action items you choose to your Reminders. Nothing is sent anywhere else.</string>
  <key>NSRemindersUsageDescription</key>
  <string>Distavo adds the action items you choose to your Reminders. Nothing is sent anywhere else.</string>
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>
  <!-- LocalNetworkPrompt browses this Bonjour type to trigger the macOS Local
       Network permission prompt when the user chooses Continue. -->
  <key>NSBonjourServices</key>
  <array>
    <string>_http._tcp</string>
  </array>
  <!-- Sparkle appcast feed. -->
  <key>SUFeedURL</key>
  <string>https://distavo.com/appcast.xml</string>
  <!-- EdDSA public key from `generate_keys` (see docs/update-verification.md).
       The matching private key is in the login Keychain, ~/.tokens, and the
       SPARKLE_ED_PRIVATE_KEY GitHub Actions secret. Public keys are not secret. -->
  <key>SUPublicEDKey</key>
  <string>jLJKwSK4YnrC9ejzSneLG2Q+7pR84m+Q3vLrgpUUKOQ=</string>
  <!-- Automation entry points (#2953), identical in every edition's plist: the
       distavo:// URL scheme and the Finder/Services "Transcribe with Distavo"
       item (handled by AutomationAppDelegate.transcribeFiles). -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>Distavo automation</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>distavo</string>
      </array>
    </dict>
  </array>
  <key>NSServices</key>
  <array>
    <dict>
      <key>NSMenuItem</key>
      <dict>
        <key>default</key>
        <string>Transcribe with Distavo</string>
      </dict>
      <key>NSMessage</key>
      <string>transcribeFiles</string>
      <key>NSPortName</key>
      <string>Distavo</string>
      <key>NSSendFileTypes</key>
      <array>
        <string>public.audiovisual-content</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
